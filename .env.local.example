NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secret. REQUIRED for admin actions like deleting/rejecting users.
# Without it, user deletion silently fails (blocked by RLS).
# Find it in Supabase: Project Settings -> API -> service_role key.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix) and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
